# Backend environment variables
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ORCHESTRATOR_MODEL=gemini-2.5-flash
FIREBASE_SERVICE_ACCOUNT_KEY=
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Weather Intelligence
OPENWEATHERMAP_API_KEY=
WEATHER_TIMEOUT=10.0
WEATHER_CACHE_TTL=600

# Crop Disease Detection
GEMINI_VISION_MODEL=gemini-2.0-flash
MAX_IMAGE_SIZE_MB=10
MAX_UPLOAD_SIZE_MB=50
DISEASE_TIMEOUT=60.0
DISEASE_CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_DISEASE_PER_MINUTE=10
RATE_LIMIT_VOICE_PER_MINUTE=20
RATE_LIMIT_WEATHER_PER_MINUTE=30
RATE_LIMIT_MARKET_PER_MINUTE=30

DEBUG=false
